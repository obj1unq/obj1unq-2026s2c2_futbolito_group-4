import objetos.*


describe "tests" {
  test "inicio" {
    const origen = game.at(0,5)
    assert.notEquals(origen, pelota.position())
    pelota.inicio()
    assert.equals(origen, pelota.position())
  }

  test "buscar" {
    assert.notEquals(pelota.position(), lionel.position())
    lionel.buscar()
    assert.equals(pelota.position(), lionel.position())
  }

  test "patear" {
    game.addVisual(lionel)
    game.addVisual(pelota)
    pelota.inicio()
    lionel.buscar()
    const posicionEsperada = game.at(3,5)
    lionel.patear()
    assert.equals(posicionEsperada, pelota.position())
  }
  test "taquito" {
    game.addVisual(lionel)
    game.addVisual(pelota)
    pelota.inicio()
    lionel.buscar()
    const posicionEsperada = game.at(0,5)
    lionel.taquito()
    assert.equals(posicionEsperada, pelota.position())
  }
  test "cambiar camiseta" { 
    lionel.position(game.at(0, 5))
    assert.equals("lionel-titular.png", lionel.image()) 
    lionel.cambiarCamiseta() 
    assert.equals("lionel-suplente.png", lionel.image())
    lionel.cambiarCamiseta() 
    assert.equals("lionel-titular.png", lionel.image()) 

    lionel.position(game.at(2, 5)) 
    assert.throwsException({ lionel.cambiarCamiseta() })
    }
}